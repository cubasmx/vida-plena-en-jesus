---
/**
 * Pie de página — Vida Plena en Jesús.
 * Sin props. Sigue docs/diseno.md §4.10 y §5 (iconos sociales en SVG inline).
 * Colores y medidas salen de los tokens de src/styles/global.css; las clases
 * propias van en el <style> scoped de este componente.
 */
import contenido from "../data/content.json";

const { site, navigation, footer } = contenido;
const { contacto, redes } = site;

/** Enlaces internos siempre con el base del despliegue (GH Pages o raíz). */
const base = import.meta.env.BASE_URL;
const interno = (href: string) => `${base}${href.replace(/^\//, "")}`;

/** Programas con página propia enlazan; el resto se muestra como texto. */
const programas = contenido.pages.home.programas.items;

const iconosRedes: Record<string, string> = {
  WhatsApp:
    "M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z",
  Facebook:
    "M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073Z",
  Instagram:
    "M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0Zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227-.224.562-.479.96-.899 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421-.569-.224-.96-.479-1.379-.899-.421-.419-.69-.824-.9-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03Zm0 3.678c-3.405 0-6.162 2.76-6.162 6.162 0 3.405 2.76 6.162 6.162 6.162 3.405 0 6.162-2.76 6.162-6.162 0-3.405-2.76-6.162-6.162-6.162ZM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4Zm7.846-10.405c0 .795-.646 1.44-1.44 1.44-.795 0-1.44-.646-1.44-1.44 0-.794.646-1.439 1.44-1.439.793-.001 1.44.645 1.44 1.439Z",
  YouTube:
    "M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814ZM9.545 15.568V8.432L15.818 12l-6.273 3.568Z",
};
---

<!-- ${footer.nota} -->
<footer class="pie">
  <div class="contenedor">
    <div class="pie__grid">
      <!-- 1. Marca -->
      <div class="pie__marca">
        <img
          class="pie__logo"
          src={`${base}images/${site.logo}`}
          alt={site.nombre}
          width="40"
          height="40"
          loading="lazy"
          decoding="async"
        />
        <p class="pie__lema">{site.lema}</p>
        <p class="pie__versiculo">
          «{site.versiculo.texto}» <span>{site.versiculo.cita}</span>
        </p>
      </div>

      <!-- 2. Navegación -->
      <nav class="pie__col" aria-label="Navegación del pie">
        <h2 class="pie__titulo">Explora</h2>
        <ul class="pie__lista" role="list">
          {navigation.map((item) => (
            <li>
              <a class="pie__enlace" href={interno(item.href)}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- 3. Programas -->
      <div class="pie__col">
        <h2 class="pie__titulo">Programas</h2>
        <ul class="pie__lista" role="list">
          {programas.map((programa) => (
            <li>
              {programa.href ? (
                <a class="pie__enlace" href={interno(programa.href)}>{programa.programa}</a>
              ) : (
                <span class="pie__texto">{programa.programa}</span>
              )}
            </li>
          ))}
        </ul>
      </div>

      <!-- 4. Contacto + redes -->
      <div class="pie__col">
        <h2 class="pie__titulo">Contacto</h2>
        <ul class="pie__lista pie__lista--contacto" role="list">
          <li class="pie__dato">
            <svg class="pie__icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
            <span>{contacto.direccion}</span>
          </li>
          <li class="pie__dato">
            <svg class="pie__icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92Z" />
            </svg>
            <a class="pie__enlace" href={`tel:${contacto.telefono.replace(/\s+/g, "")}`}>{contacto.telefono}</a>
          </li>
          <li class="pie__dato">
            <svg class="pie__icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2" />
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
            </svg>
            <a class="pie__enlace" href={`mailto:${contacto.email}`}>{contacto.email}</a>
          </li>
        </ul>

        <ul class="pie__redes" role="list">
          {redes.map((red) => (
            <li>
              <a
                class="pie__red"
                href={red.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={red.nombre}
              >
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={iconosRedes[red.nombre]} />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="pie__legal">
      <p>{footer.copyright}</p>
    </div>
  </div>
</footer>

<style>
  .pie {
    background-color: var(--vpj-primary-dark);
    color: var(--vpj-text-on-dark);
    padding-block: var(--vpj-space-7);
  }

  .pie__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--vpj-space-6);
  }

  /* 1. Marca */
  .pie__marca {
    display: flex;
    flex-direction: column;
    gap: var(--vpj-space-3);
  }
  .pie__logo {
    width: 40px;
    height: 40px;
  }
  .pie__lema {
    max-width: 32ch;
    font-family: var(--vpj-font-display);
    font-size: var(--vpj-text-base);
    font-weight: 600;
    line-height: 1.3;
    color: var(--vpj-text-on-dark);
  }
  .pie__versiculo {
    max-width: 34ch;
    font-size: var(--vpj-text-sm);
    font-style: italic;
    color: var(--vpj-white-72);
  }
  .pie__versiculo span {
    display: block;
    margin-top: var(--vpj-space-1);
    font-size: var(--vpj-text-xs);
    font-style: normal;
    text-transform: uppercase;
    letter-spacing: var(--vpj-tracking-label);
    color: var(--vpj-primary-100);
  }

  /* 2–4. Columnas */
  .pie__titulo {
    margin-bottom: var(--vpj-space-4);
    font-family: var(--vpj-font-display);
    font-size: var(--vpj-text-xs);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: var(--vpj-tracking-label);
    text-transform: uppercase;
    color: var(--vpj-primary-100);
  }
  .pie__lista {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pie__lista li + li {
    margin-top: var(--vpj-space-3);
  }

  .pie__enlace {
    color: var(--vpj-text-on-dark);
    font-size: var(--vpj-text-sm);
    text-decoration: none;
  }
  .pie__enlace:hover {
    color: var(--vpj-primary-100);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .pie__texto {
    display: inline-block;
    color: var(--vpj-white-72);
    font-size: var(--vpj-text-sm);
  }

  /* Contacto */
  .pie__lista--contacto li + li {
    margin-top: var(--vpj-space-4);
  }
  .pie__dato {
    display: flex;
    align-items: flex-start;
    gap: var(--vpj-space-2);
    font-size: var(--vpj-text-sm);
    line-height: 1.45;
    color: var(--vpj-white-72);
  }
  .pie__dato > :last-child {
    padding-top: 1px;
  }
  .pie__icono {
    flex: none;
    width: 20px;
    height: 20px;
    margin-top: 1px;
    color: var(--vpj-primary-100);
  }

  /* Redes */
  .pie__redes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--vpj-space-4);
    margin: 0;
    margin-top: var(--vpj-space-5);
    padding: 0;
    list-style: none;
  }
  .pie__red {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--vpj-radius-pill);
    color: var(--vpj-text-on-dark);
    transition: background-color 0.18s ease, color 0.18s ease;
  }
  .pie__red:hover {
    background-color: rgba(255, 255, 255, 0.14);
    color: var(--vpj-primary-100);
  }
  .pie__red svg {
    width: 24px;
    height: 24px;
  }

  /* Barra legal */
  .pie__legal {
    margin-top: var(--vpj-space-7);
    padding-top: var(--vpj-space-5);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .pie__legal p {
    max-width: none;
    font-size: var(--vpj-text-xs);
    line-height: 1.45;
    color: var(--vpj-white-72);
  }

  /* Foco visible sobre fondo oscuro (docs §6.3) */
  .pie a:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 2px;
  }

  /* ≥768 — 2 columnas */
  @media (min-width: 768px) {
    .pie__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--vpj-space-7) var(--vpj-space-6);
    }
  }

  /* ≥1024 — 4 columnas */
  @media (min-width: 1024px) {
    .pie {
      padding-block: var(--vpj-space-8);
    }
    .pie__grid {
      grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    }
  }
</style>

---
import Base from "../layouts/Base.astro";
import content from "../data/content.json";

const site = content.site;
const home = content.pages.home;
const base = import.meta.env.BASE_URL;
const img = (file) => `${base}images/${file}`;
---

<Base title={home.seo.title} description={home.seo.descripcion}>
  <!-- HERO -->
  <section class="hero">
    <img
      class="hero__img"
      src={img("vaticano.webp")}
      alt="Calle de Roma con la Basílica de San Pedro al fondo"
      width="1600"
      height="1067"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero__velo"></div>
    <div class="hero__contenido contenedor">
      <h1>{home.hero.titulo}</h1>
      <p class="hero__sub">{home.hero.subtitulo}</p>
      <div class="hero__botones">
        <a class="boton boton--primario" href={`${base}quienes-somos`}>
          {home.intro.ctas[0].texto}
        </a>
        <a class="boton boton--secundario" href={`${base}equipo`}>
          {home.intro.ctas[1].texto}
        </a>
      </div>
    </div>
  </section>

  <!-- VERSÍCULO -->
  <section class="versiculo">
    <blockquote class="contenedor">
      <p>{site.versiculo.texto}</p>
      <cite>{site.versiculo.cita}</cite>
    </blockquote>
  </section>

  <!-- OFRECEMOS -->
  <section class="seccion">
    <div class="contenedor">
      <p class="eyebrow">{home.intro.texto}</p>
      <h2>{home.ofrecemos.titulo}</h2>
      <div class="grid grid--4">
        {home.ofrecemos.items.map((item) => (
          <article class="tarjeta">
            <img
              src={img(item.imagen)}
              alt={item.texto}
              width="600"
              height="400"
              loading="lazy"
              decoding="async"
            />
            <h3>{item.texto}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PROGRAMAS -->
  <section class="seccion seccion--alt">
    <div class="contenedor">
      <h2>{home.programas.titulo}</h2>
      <div class="grid grid--4">
        {
          [
            { item: home.programas.items[0], href: "/quienes-somos" },
            { item: home.programas.items[1], href: "/proyecto-familia" },
            { item: home.programas.items[2], href: "/youth-project" },
            { item: home.programas.items[3], href: "/curso-internacional" },
          ].map(({ item, href }) => (
            <article class="tarjeta">
              <img
                src={img(item.imagen)}
                alt={item.titulo}
                width="600"
                height="400"
                loading="lazy"
                decoding="async"
              />
              <p class="tarjeta__programa">{item.programa}</p>
              <h3>{item.titulo}</h3>
              <p class="tarjeta__meta">Dirigido a: {item.dirigidoA}</p>
              <a class="boton boton--texto" href={`${base}${href.slice(1)}`}>
                {home.programas.btn}
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CONTACTO -->
  <section class="seccion contacto">
    <div class="contenedor">
      <h2>{home.contacto.titulo}</h2>
      <ul class="contacto__lista">
        <li>{home.contacto.direccion}</li>
        <li>
          <a href={`tel:${home.contacto.telefono.replace(/\s+/g, "")}`}>
            {home.contacto.telefono}
          </a>
        </li>
        <li>
          <a href={`mailto:${home.contacto.email}`}>{home.contacto.email}</a>
        </li>
      </ul>
      <a class="boton boton--whatsapp" href={home.contacto.whatsapp} target="_blank" rel="noopener noreferrer">
        Escríbenos por WhatsApp
      </a>
    </div>
  </section>
</Base>

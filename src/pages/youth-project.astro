---
import Base from "../layouts/Base.astro";
import content from "../data/content.json";

const yp = content.pages.youthProject;
const base = import.meta.env.BASE_URL;
const img = (file) => `${base}images/${file}`;
const cursos = Array.isArray(yp.cursos) ? yp.cursos : yp.cursos.items;
const duracionComun = yp.cursos.duracionComun ?? cursos[0]?.duracion ?? "";
---

<Base title={yp.seo.title} description={yp.seo.descripcion}>
  <!-- HERO -->
  <section class="hero-youth">
    <div class="hero-youth__contenido contenedor">
      <img
        class="hero-youth__logo"
        src={img(yp.hero.logo)}
        alt="Logotipo de Youth Project"
        width="200"
        height="200"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <h1>{yp.hero.titulo}</h1>
      <p class="hero-youth__sub">{yp.hero.subtitulo}</p>
    </div>
  </section>

  <!-- CURSOS -->
  <section class="seccion">
    <div class="contenedor">
      <p class="eyebrow">Formación juvenil</p>
      <h2>Cursos del Youth Project</h2>
      <p class="tarjeta__meta">Duración de cada curso: {duracionComun}</p>
      <div class="grid grid--cursos">
        {
          cursos.map((curso) => (
            <article class="tarjeta">
              <img
                src={img(curso.imagen)}
                alt={`Curso ${curso.titulo}`}
                width="640"
                height="360"
                loading="lazy"
                decoding="async"
              />
              <h3>{curso.titulo}</h3>
              {curso.duracion && <p class="tarjeta__meta">Duración: {curso.duracion}</p>}
              <p>{curso.descripcion}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- MAR ADENTRO -->
  <section class="seccion seccion--alt mar-adentro">
    <div class="contenedor mar-adentro__contenido">
      <div class="mar-adentro__texto">
        <p class="eyebrow">{yp.marAdentro.subtitulo}</p>
        <h2>{yp.marAdentro.titulo}</h2>
        <p>{yp.marAdentro.texto}</p>
      </div>
      <img
        class="mar-adentro__imagen"
        src={img(yp.hero.imagen)}
        alt="Jóvenes misioneros de Mar Adentro en misión"
        width="1280"
        height="720"
        loading="lazy"
        decoding="async"
      />
    </div>
  </section>
</Base>

<style>
  .hero-youth {
    background: linear-gradient(135deg, #1b2a4a 0%, #0f1b33 100%);
    color: #fff;
    padding: 3.5rem 0;
    text-align: center;
  }

  .hero-youth__contenido {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-youth__logo {
    width: 120px;
    height: auto;
  }

  .hero-youth__contenido h1 {
    margin: 0;
    font-size: clamp(2rem, 6vw, 3.25rem);
    line-height: 1.1;
  }

  .hero-youth__sub {
    max-width: 42ch;
    margin: 0;
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    opacity: 0.9;
  }

  .grid--cursos {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .grid--cursos .tarjeta img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 0.5rem;
  }

  .mar-adentro__contenido {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  .mar-adentro__imagen {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 0.75rem;
  }

  @media (min-width: 640px) {
    .grid--cursos {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .grid--cursos {
      grid-template-columns: repeat(3, 1fr);
    }

    .mar-adentro__contenido {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }
</style>
